# RevenueCat API Keys
# Get these from RevenueCat Dashboard: https://app.revenuecat.com
# Go to Project Settings > API Keys

# iOS API Key (public key)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_api_key_here

# Android API Key (public key)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Set to true only when the matching App Store / Play billing products are ready for release
EXPO_PUBLIC_ENABLE_PURCHASES=false
